@model ChatViewModel

@{
    ViewData["Title"] = "Chat";
}

@section Scripts {
    <script src="~/js/Chat/RecibirMensaje.js"></script>
}

<div class="chat-shell">
    <aside class="chat-sidebar">
        <div class="sidebar-heading">
            <div>
                <span class="eyebrow">Tu espacio</span>
                <h2>Conversaciones</h2>
            </div>
            <form asp-action="NuevaConversacion" method="post">
                <button class="new-chat-btn" type="submit" title="Nueva conversación" aria-label="Nueva conversación">+</button>
            </form>
        </div>

        <div class="conversation-list">
            @if (!Model.Conversaciones.Any())
            {
                <div class="empty-sidebar">Todavía no hay conversaciones.</div>
            }
            @foreach (var conversacion in Model.Conversaciones)
            {
                var activeClass = Model.ConversacionActual?.Id == conversacion.Id ? "active" : "";
                <div class="conversation-item @activeClass">
                    <a asp-action="Index" asp-route-id="@conversacion.Id" id="conversacion-link-@conversacion.Id">
                        <span class="conversation-icon">✦</span>
                        <span>@conversacion.Titulo</span>
                    </a>
                    <form asp-action="EliminarConversacion" asp-route-id="@conversacion.Id" method="post">
                        <button type="submit" class="delete-chat" title="Eliminar conversación" aria-label="Eliminar conversación">×</button>
                    </form>
                </div>
            }
        </div>
    </aside>

    <section class="chat-panel">
        @if (Model.ConversacionActual == null)
        {
            <div class="chat-empty-state">
                <span class="empty-orb">N</span>
                <h1>Empezá una conversación</h1>
                <p>Creá un chat nuevo y elegí si querés conversar con Ollama local o GitHub Models.</p>
                <form asp-action="NuevaConversacion" method="post">
                    <button class="btn btn-primary btn-lg" type="submit">Crear primera conversación</button>
                </form>
            </div>
        }
        else
        {
            <header class="chat-header">
                <div>
                    <span class="eyebrow">Conversación activa</span>
                    <h1 id="tituloConversacion">@Model.ConversacionActual.Titulo</h1>
                </div>
                <div class="provider-field">
                    <label for="providerSelect">Modelo</label>
                    <select id="providerSelect" class="form-select">
                        <option value="1">Ollama · local</option>
                        <option value="2">GitHub Models · nube</option>
                    </select>
                </div>
            </header>

            <div id="chatMessages" class="chat-messages">
                @if (!Model.ConversacionActual.Mensajes.Any())
                {
                    <div class="conversation-welcome">
                        <span>✦</span>
                        <strong>Todo listo.</strong>
                        <p>Preguntá sobre NLP, .NET, RAG o el funcionamiento del proyecto.</p>
                    </div>
                }
                @foreach (var mensaje in Model.ConversacionActual.Mensajes.OrderBy(m => m.Fecha))
                {
                    if (mensaje.Rol == "user")
                    {
                        <div class="message-row user-row">
                            <div class="message-bubble user-bubble">@mensaje.Contenido</div>
                            <span class="message-avatar user-avatar">V</span>
                        </div>
                    }
                    else
                    {
                        <div class="message-row bot-row">
                            <span class="message-avatar bot-avatar">N</span>
                            <div class="message-bubble bot-bubble">@mensaje.Contenido</div>
                        </div>
                    }
                }
            </div>

            <form id="chatForm" class="chat-composer">
                <input type="hidden" id="conversacionId" value="@Model.ConversacionActual.Id" />
                <input id="mensajeInput" class="form-control" maxlength="4000"
                       placeholder="Escribí un mensaje..." autocomplete="off" />
                <button id="enviarBtn" class="send-button" type="submit" aria-label="Enviar mensaje">Enviar <span>↑</span></button>
            </form>
            <p class="composer-note">La IA puede cometer errores. Verificá la información importante.</p>
        }
    </section>
</div>
