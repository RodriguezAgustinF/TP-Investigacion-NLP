@model ChatViewModel

@{
    ViewData["Title"] = "Chat";
}

<div class="row">

    <!-- Sidebar -->
    <div class="col-3 border-end">

        <form asp-action="NuevaConversacion" method="post">

            <button class="btn btn-success w-100 mb-3">
                + Nuevo chat
            </button>

        </form>

        @foreach (var conversacion in Model.Conversaciones)
        {
            <a asp-action="Index"
               asp-route-id="@conversacion.Id"
               class="list-group-item list-group-item-action mb-2">

                @conversacion.Titulo

            </a>
        }

    </div>

    <!-- Chat -->

    <div class="col-9">

        @if (Model.ConversacionActual == null)
        {
            <div class="text-center mt-5">

                <h2>Bienvenido 👋</h2>

                <p>Creá una conversación para comenzar.</p>

            </div>
        }
        else
        {
            <h3>@Model.ConversacionActual.Titulo</h3>

            <hr />

            <div style="height:500px; overflow-y:auto;" class="mb-3">

                @foreach (var mensaje in Model.ConversacionActual.Mensajes)
                {
                    if (mensaje.Rol == "user")
                    {
                        <div class="text-end mb-3">

                            <span class="badge bg-primary">
                                Vos
                            </span>

                            <div class="mt-1">

                                @mensaje.Contenido

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="text-start mb-3">

                            <span class="badge bg-success">
                                Asistente
                            </span>

                            <div class="mt-1">

                                @mensaje.Contenido

                            </div>

                        </div>
                    }
                }

            </div>

            <form asp-action="EnviarMensaje" method="post">

                <input type="hidden"
                       name="conversacionId"
                       value="@Model.ConversacionActual.Id" />

                <div class="input-group">

                    <input asp-for="NuevoMensaje"
                           class="form-control"
                           placeholder="Escribí un mensaje..." />

                    <button class="btn btn-primary">

                        Enviar

                    </button>

                </div>

            </form>
        }

    </div>

</div>