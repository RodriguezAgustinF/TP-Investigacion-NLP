@{
    Layout = "_BaseLayout";
}

@section Menu {
    <nav class="navbar navbar-expand-lg app-navbar">
        <div class="container app-nav-container">
            <a class="navbar-brand" asp-controller="Chat" asp-action="Index">
                <span class="brand-mark">N</span>
                <span>NLP Chat <small>UNLaM</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarLogueado"
                    aria-controls="navbarLogueado" aria-expanded="false" aria-label="Mostrar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="navbarLogueado" class="navbar-collapse collapse justify-content-between">
                <div class="navbar-nav ms-lg-4">
                    <a class="nav-link" asp-controller="Chat" asp-action="Index">Mis conversaciones</a>
                </div>
                <form class="d-flex" asp-controller="Usuario" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-secondary">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>
}

<div class="container app-content">
    <main role="main">
        @RenderBody()
    </main>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
