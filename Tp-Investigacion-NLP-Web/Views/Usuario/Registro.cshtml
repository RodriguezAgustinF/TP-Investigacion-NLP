@{
    Layout = "_AnonimoLayout";
    ViewData["Title"] = "Crear cuenta";
}
@section Scripts {
    <script src="~/js/Usuario/ValidacionFormRegistro.js"></script>
}
@model RegistroViewModel

<div class="auth-page">
    <div class="card auth-card auth-card-wide">
        <div class="card-body">
            <span class="auth-icon">N</span>
            <div class="text-center mb-4">
                <h1>Creá tu espacio de chat</h1>
                <p class="text-muted">Guardá conversaciones y probá distintos modelos de IA.</p>
            </div>
            <form asp-action="Registro" asp-controller="Usuario" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label">Nombre</label>
                        <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Tu nombre" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Correo electrónico</label>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="nombre@ejemplo.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Elegí una contraseña" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmarPassword" class="form-label">Confirmar contraseña</label>
                        <input asp-for="ConfirmarPassword" type="password" class="form-control form-control-lg" placeholder="Repetí la contraseña" />
                        <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">Crear mi cuenta</button>
            </form>
            <p class="auth-switch">¿Ya tenés cuenta? <a asp-action="Login">Iniciá sesión</a></p>
        </div>
    </div>
</div>
